---
import { getCollection } from 'astro:content';
import { includeInListings } from '@/utils/blog';
import BaseLayout from '@/layouts/BaseLayout.astro';
import FAQ from '@/components/FAQ.astro';
import { homeFAQ } from '@/data/faq';
import { faqSchema } from '@/utils/schema';

const posts = (await getCollection('blog', includeInListings))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 3);

const studioAreas = [
  ['MON', 'Monitoração', 'Mais clareza para decidir com confiança no seu estúdio.', '/studio/monitoracao'],
  ['I/O', 'Conversão e interfaces', 'Defina conexões, canais e expansão de acordo com sua rotina.', '/studio/interfaces-e-conversao'],
  ['O/B', 'Outboard e setup híbrido', 'Integre equipamentos analógicos com roteamento simples e previsível.', '/studio/outboard-e-setup-hibrido'],
  ['360', 'Projetos completos', 'Planeje equipamentos, infraestrutura e integração em conjunto.', '/studio/projetos-completos'],
];

const brands = ['SSL', 'PMC', 'NEUMANN', 'ADAM AUDIO', 'ANTELOPE AUDIO', 'PRESONUS', 'VIOLET AUDIO'];
---

<BaseLayout schema={faqSchema(homeFAQ)}>
  <main class="home-redesign">
    <section class="visual-hero">
      <div class="visual-hero-copy">
        <span class="kicker">Projetos Pro Audio · Consultoria em áudio profissional</span>
        <h1>Qual é o próximo upgrade certo para o seu estúdio?</h1>
        <p>Orientação técnica para escolher monitoração, conversão e pré-amplificação de acordo com sua sala e seu trabalho.</p>
        <div class="btn-row">
          <a href="/diagnostico-de-setup" class="btn btn-primary">Analisar meu setup</a>
          <a href="/conteudos" class="editorial-link">Ver conteúdos <span>→</span></a>
        </div>
      </div>
      <div class="visual-hero-media">
        <img src="/images/rodrigo-sentado-estudio.webp" alt="Rodrigo Chiacchio em estúdio profissional de áudio" width="1646" height="956" fetchpriority="high" />
        <div class="hero-caption"><strong>Rodrigo Chiacchio</strong><span>Quase 30 anos em áudio e tecnologia</span></div>
      </div>
    </section>

    <section class="brand-strip" aria-label="Marcas e ecossistemas">
      <div class="brand-track">{brands.map((brand) => <span>{brand}</span>)}</div>
    </section>

    <section class="home-block">
      <div class="home-container">
        <div class="center-title">
          <span class="kicker">Por onde começar</span>
          <h2>Onde seu setup precisa evoluir?</h2>
        </div>
        <div class="decision-grid">
          {studioAreas.map(([icon, title, description, href]) => (
            <a class="decision-card" href={href}>
              <span class="line-icon">{icon}</span>
              <h3>{title}</h3>
              <p>{description}</p>
              <span class="card-arrow">→</span>
            </a>
          ))}
        </div>
      </div>
    </section>

    <section class="home-block services-block">
      <div class="home-container">
        <div class="center-title"><h2>Studio e Live Sound</h2></div>
        <div class="service-grid">
          <article class="service-card">
            <img src="/images/real/ssl900_site-OwEpoEGYUBs0ktyw.jpg" alt="Console SSL em estúdio profissional" width="1185" height="667" />
            <div class="service-copy">
              <h3>Studio</h3>
              <p>Equipamentos e integração para produção, mixagem e masterização.</p>
              <ul><li>Upgrade</li><li>Monitoração</li><li>Conversão</li><li>Outboard</li></ul>
              <a href="/studio">Saiba mais →</a>
            </div>
          </article>
          <article class="service-card">
            <img src="/images/studiolive-se32r-igrejas.webp" alt="Console PreSonus StudioLive em uma igreja" width="1254" height="1254" loading="lazy" />
            <div class="service-copy">
              <h3>Live Sound</h3>
              <p>Consoles, redes e monitoração para sonorização e produção de eventos.</p>
              <ul><li>StudioLive</li><li>Áudio em rede</li><li>Violet Audio</li><li>Monitoração pessoal</li></ul>
              <a href="/live-sound">Saiba mais →</a>
            </div>
          </article>
        </div>
      </div>
    </section>

    <section class="home-block diagnostic-wrap">
      <div class="home-container diagnostic-panel">
        <div class="diagnostic-copy">
          <span class="kicker">Diagnóstico de setup</span>
          <h2>Seu próximo investimento começa com um bom diagnóstico.</h2>
          <p>Conte o que você usa hoje, onde está o gargalo e o resultado que procura. O contexto vem antes da recomendação.</p>
          <div class="diagnostic-points"><span>Setup atual</span><span>Principal desafio</span><span>Faixa de investimento</span></div>
          <a class="btn btn-primary" href="/diagnostico-de-setup">Enviar meu setup</a>
          <small>Seus dados são usados apenas para a análise e o contato solicitado.</small>
        </div>
        <div class="diagnostic-image">
          <img src="/images/rodrigo-equipamentos-ssl.webp" alt="Rodrigo Chiacchio ajustando equipamentos SSL em estúdio profissional" width="1762" height="893" loading="lazy" />
        </div>
      </div>
    </section>

    <section class="home-block">
      <div class="home-container">
        <div class="guide-home-panel">
          <div>
            <span class="kicker">Guia de Equipamentos</span>
            <h2>Compare caminhos antes de escolher um produto.</h2>
            <p>Encontre interfaces, monitores, outboard, microfones, controladores e consoles organizados por aplicação e complexidade.</p>
          </div>
          <div class="guide-home-actions">
            <a class="btn btn-primary" href="/guia-de-equipamentos">Explorar o guia</a>
            <a href="/diagnostico-de-setup">Preciso analisar meu sistema →</a>
          </div>
        </div>
      </div>
    </section>

    <section class="home-block">
      <div class="home-container">
        <div class="center-title"><span class="kicker">Guias e análises</span><h2>Informação técnica para decidir melhor</h2></div>
        <div class="content-cards">
          {posts.map((post) => (
            <a href={`/blog/${post.id}`} class="content-card">
              {post.data.heroImage && <img src={post.data.heroImage} alt={post.data.title} width="1500" height="844" />}
              <div><span class="kicker">{post.data.tags[0] ?? 'Conteúdo'}</span><h3>{post.data.title}</h3><p>{post.data.description}</p><strong>Ler artigo →</strong></div>
            </a>
          ))}
        </div>
      </div>
    </section>

    <section class="home-block case-block">
      <div class="home-container">
        <div class="center-title"><span class="kicker">Integração de sistemas</span><h2>Uma configuração coerente começa pelo conjunto</h2></div>
        <article class="case-card">
          <img src="/images/real/projetos-ssl-swa-948-delta-Bf7ipliE8L0dOPSu.jpg" alt="Projeto de integração SSL em estúdio" width="994" height="425" />
          <div class="case-copy">
            <span class="kicker">Integração SSL</span>
            <h3>Superfície, interfaces e workflow precisam funcionar como um sistema.</h3>
            <div class="case-steps">
              <div><strong>01 · Necessidade</strong><p>Reduzir trocas de conexão e etapas desnecessárias durante as sessões.</p></div>
              <div><strong>02 · Planejamento</strong><p>Definir em conjunto controle, conversão, roteamento e cabeamento.</p></div>
              <div><strong>03 · Operação</strong><p>Manter os recursos importantes acessíveis e facilitar futuras expansões.</p></div>
            </div>
          </div>
        </article>
      </div>
    </section>

    <section class="home-block about-block">
      <div class="home-container about-grid">
        <img src="/images/rodrigo-bracos-cruzados.webp" alt="Rodrigo Chiacchio de braços cruzados em estúdio profissional" width="1024" height="1536" loading="lazy" />
        <div class="about-copy">
          <span class="kicker">Experiência para orientar</span>
          <h2>Decisões importantes pedem contexto de mercado e visão técnica.</h2>
          <p>Rodrigo Chiacchio atua há quase 30 anos no mercado de áudio e tecnologia, com passagens por Mastermídia, Quanta Brasil, Next Audio, Quanta Store, Music Company e Quanta Pro.</p>
          <p>O trabalho começa pela necessidade de cada operação para identificar o que pode melhorar o resultado, a agilidade ou a confiabilidade do sistema.</p>
          <a href="/sobre-rodrigo">Conheça minha trajetória →</a>
        </div>
        <div class="about-stats">
          <div><strong>Quase 30 anos</strong><span>em áudio e tecnologia</span></div>
          <div><strong>Studio + Live</strong><span>visão de sistemas completos</span></div>
          <div><strong>Mercado brasileiro</strong><span>rede técnica e comercial</span></div>
        </div>
      </div>
    </section>

    <FAQ items={homeFAQ} title="Dúvidas antes de começar" />

    <section class="final-cta">
      <div class="home-container">
        <div><span class="kicker">Próximo passo</span><h2>Vamos analisar o próximo passo do seu projeto?</h2></div>
        <div class="final-actions"><a href="/contato" class="btn btn-secondary">Falar com Rodrigo</a><a href="/diagnostico-de-setup" class="btn btn-primary">Enviar meu setup</a></div>
      </div>
    </section>
  </main>
</BaseLayout>

<style>
  .home-redesign { --home-width: 1280px; --space-section: 58px; --space-content: 26px; --space-cards: 16px; background: #f6f6f3; color: #111517; }
  .home-container { width: min(calc(100% - 48px), var(--home-width)); margin-inline: auto; }
  .kicker { display: inline-block; color: #23628d; font-size: .68rem; font-weight: 850; letter-spacing: .08em; text-transform: uppercase; }
  .visual-hero { display: grid; grid-template-columns: minmax(0, 44fr) minmax(0, 56fr); height: 500px; background: #f8f8f6; border-bottom: 1px solid #d7d7d2; }
  .visual-hero-copy { display: flex; flex-direction: column; justify-content: center; padding: 46px clamp(34px, 4.5vw, 72px); }
  .visual-hero-copy h1 { max-width: 13ch; margin-top: 11px; font-size: clamp(3rem, 4vw, 3.5rem); line-height: 1; letter-spacing: -.055em; }
  .visual-hero-copy > p { max-width: 48ch; margin-top: 16px; color: #5d6061; font-size: clamp(1rem, 1.25vw, 1.0625rem); line-height: 1.5; }
  .visual-hero-copy .btn-row { margin-top: 22px; }
  .visual-hero-copy .btn { min-height: 44px; padding-inline: 18px; font-size: .84rem; }
  .visual-hero-media { position: relative; min-height: 500px; overflow: hidden; background: #202426; }
  .visual-hero-media::after { content: ""; position: absolute; inset: 0; background: linear-gradient(90deg, rgba(0,0,0,.13), transparent 40%), linear-gradient(0deg, rgba(0,0,0,.3), transparent 38%); }
  .visual-hero-media img { width: 100%; height: 100%; object-fit: cover; object-position: center 34%; filter: saturate(.82) contrast(1.04); }
  .hero-caption { position: absolute; z-index: 1; left: 22px; bottom: 20px; display: grid; color: #fff; font-size: .86rem; }
  .hero-caption span { font-size: .78rem; opacity: .82; }
  .editorial-link { display: inline-flex; align-items: center; gap: 16px; border-bottom: 1px solid #111; padding: 0 0 4px; font-weight: 750; }
  .guide-home-panel { display: grid; grid-template-columns: 1.4fr auto; gap: 40px; align-items: center; padding: 32px; border: 1px solid #c9d7df; border-radius: 5px; background: #eaf1f5; }
  .guide-home-panel h2 { max-width: 20ch; margin-top: 5px; font-size: clamp(1.8rem, 2.7vw, 2.5rem); letter-spacing: -.045em; }
  .guide-home-panel p { max-width: 65ch; margin-top: 10px; color: #596267; line-height: 1.55; }
  .guide-home-actions { display: grid; gap: 12px; justify-items: center; min-width: 210px; }
  .guide-home-actions a:not(.btn) { color: #245f86; font-size: .82rem; font-weight: 750; }
  .brand-strip { background: #fff; border-bottom: 1px solid #d7d7d2; }
  .brand-track { width: min(calc(100% - 48px), var(--home-width)); min-height: 68px; margin: auto; display: flex; align-items: center; justify-content: space-between; gap: 24px; overflow: hidden; }
  .brand-track span { color: #25292b; font-size: clamp(.7rem, 1.05vw, .92rem); font-weight: 900; letter-spacing: .01em; white-space: nowrap; }
  .home-block { padding: var(--space-section) 0; border-bottom: 1px solid #dddcd7; }
  .center-title { margin-bottom: var(--space-content); text-align: center; }
  .center-title h2 { margin-top: 5px; font-size: clamp(1.75rem, 2.4vw, 2.125rem); letter-spacing: -.045em; }
  .decision-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: var(--space-cards); }
  .decision-card { position: relative; min-height: 188px; padding: 21px; background: #fff; border: 1px solid #d4d4d0; border-radius: 5px; transition: transform .2s, box-shadow .2s; }
  .decision-card:hover { transform: translateY(-4px); box-shadow: 0 14px 30px rgba(0,0,0,.07); }
  .line-icon { display: grid; place-items: center; width: 44px; height: 35px; border: 1px solid #1a1d1f; border-radius: 4px; font-size: .62rem; font-weight: 900; letter-spacing: .06em; }
  .decision-card h3 { margin-top: 16px; font-size: 1.08rem; }
  .decision-card p { margin-top: 7px; color: #626566; font-size: .82rem; line-height: 1.45; }
  .card-arrow { position: absolute; right: 18px; bottom: 13px; font-size: 1.25rem; }
  .services-block { background: #ecece9; }
  .service-grid { display: grid; grid-template-columns: 1fr 1fr; gap: var(--space-cards); }
  .service-card { display: grid; grid-template-columns: 1.25fr .9fr; min-height: 294px; max-height: 310px; overflow: hidden; background: #fff; border: 1px solid #d4d4d0; border-radius: 6px; }
  .service-card > img { width: 100%; height: 100%; object-fit: cover; }
  .service-copy { padding: 22px 20px; }
  .service-copy h3 { margin-top: 5px; font-size: 1.42rem; }
  .service-copy p { margin-top: 8px; color: #626566; font-size: .82rem; line-height: 1.45; }
  .service-copy ul { margin-top: 12px; padding-left: 16px; color: #444; font-size: .75rem; line-height: 1.45; }
  .service-copy a, .case-copy > a, .about-copy a { display: inline-block; margin-top: 13px; color: #174f79; font-size: .82rem; font-weight: 800; }
  .diagnostic-wrap { background: #f1f1ee; }
  .diagnostic-panel { display: grid; grid-template-columns: 1fr 1.08fr; min-height: 320px; max-height: 350px; overflow: hidden; background: white; border: 1px solid #d4d4d0; border-radius: 6px; }
  .diagnostic-copy { padding: clamp(28px, 3vw, 42px); }
  .diagnostic-copy h2 { max-width: 17ch; margin-top: 7px; font-size: clamp(1.75rem, 2.4vw, 2.125rem); }
  .diagnostic-copy p { max-width: 58ch; margin-top: 10px; color: #606364; font-size: .9rem; line-height: 1.5; }
  .diagnostic-points { display: flex; flex-wrap: wrap; gap: 7px; margin: 16px 0; }
  .diagnostic-points span { padding: 8px 10px; background: #f1f2f1; border: 1px solid #d8d8d4; border-radius: 3px; font-size: .72rem; }
  .diagnostic-copy .btn { min-height: 43px; font-size: .82rem; }
  .diagnostic-copy small { display: block; margin-top: 9px; color: #777; font-size: .68rem; }
  .diagnostic-image img { width: 100%; height: 100%; object-fit: cover; }
  .content-cards { display: grid; grid-template-columns: repeat(3, 1fr); gap: var(--space-cards); }
  .content-card { overflow: hidden; background: #fff; border: 1px solid #d4d4d0; border-radius: 5px; }
  .content-card img { display: block; width: 100%; height: clamp(140px, 10vw, 160px); aspect-ratio: 3.75 / 1; object-fit: cover; object-position: center; filter: saturate(.8); }
  .content-card > div { padding: 19px 20px; }
  .content-card h3 { margin-top: 6px; font-size: 1.15rem; }
  .content-card p { margin-top: 8px; color: #656869; font-size: .81rem; line-height: 1.45; }
  .content-card strong { display: inline-block; margin-top: 13px; color: #174f79; font-size: .74rem; }
  .case-block { background: #efefec; }
  .case-card { display: grid; grid-template-columns: .95fr 1.25fr; overflow: hidden; background: white; border: 1px solid #d2d2ce; border-radius: 6px; }
  .case-card > img { width: 100%; height: 100%; min-height: 290px; max-height: 310px; object-fit: cover; }
  .case-copy { padding: 28px; }
  .case-copy h3 { max-width: 25ch; margin-top: 6px; font-size: clamp(1.55rem, 2.2vw, 2rem); }
  .case-steps { display: grid; grid-template-columns: repeat(3, 1fr); gap: 16px; margin-top: 20px; padding-top: 17px; border-top: 1px solid #ddd; }
  .case-steps strong { font-size: .77rem; text-transform: uppercase; }
  .case-steps p { margin-top: 8px; color: #676a6b; font-size: .8rem; }
  .about-block { background: white; }
  .about-grid { display: grid; grid-template-columns: .68fr 1.5fr .7fr; gap: 28px; align-items: center; }
  .about-grid > img { width: 100%; height: clamp(320px, 26vw, 370px); object-fit: cover; border-radius: 5px; }
  .about-copy h2 { max-width: 24ch; margin-top: 6px; font-size: clamp(1.75rem, 2.4vw, 2.125rem); }
  .about-copy p { margin-top: 10px; color: #606364; font-size: .87rem; line-height: 1.5; }
  .about-stats { display: grid; gap: 17px; }
  .about-stats > div { padding-top: 10px; border-top: 2px solid #15191b; }
  .about-stats strong, .about-stats span { display: block; }
  .about-stats span { color: #6b6d6e; font-size: .78rem; }
  .home-redesign :global(.section) { padding-block: 52px; }
  .home-redesign :global(.accordion-trigger) { padding-block: 16px; font-size: .9rem; }
  .home-redesign :global(.accordion-body) { padding-bottom: 16px; }
  .final-cta { padding: 25px 0; color: white; background: #11191d; }
  .final-cta .home-container { display: flex; justify-content: space-between; align-items: center; gap: 30px; }
  .final-cta h2 { max-width: 24ch; margin-top: 4px; font-size: clamp(1.65rem, 2.3vw, 2.1rem); }
  .final-cta .kicker { color: #86b7d7; }
  .final-actions { display: flex; gap: 12px; }
  .final-actions .btn-primary { background: white; color: #111; }
  .final-actions .btn-secondary { background: transparent; color: white; border-color: #889296; }

  @media (max-width: 980px) {
    .home-redesign { --space-section: 52px; }
    .visual-hero { grid-template-columns: 1fr; height: auto; }
    .visual-hero-copy { min-height: 420px; }
    .visual-hero-media { min-height: 440px; }
    .decision-grid, .content-cards { grid-template-columns: repeat(2, 1fr); }
    .service-grid { grid-template-columns: 1fr; }
    .guide-home-panel { grid-template-columns: 1fr; }
    .guide-home-actions { justify-items: start; }
    .service-card { max-height: none; }
    .about-grid { grid-template-columns: .75fr 1.25fr; }
    .about-stats { grid-column: 1 / -1; grid-template-columns: repeat(3, 1fr); }
  }
  @media (max-width: 640px) {
    .home-redesign { --space-section: 44px; }
    .home-container { width: min(calc(100% - 28px), var(--home-width)); }
    .visual-hero-copy { min-height: auto; padding: 48px 22px; }
    .visual-hero-copy h1 { font-size: clamp(2.65rem, 13vw, 4rem); }
    .visual-hero-media { min-height: 430px; }
    .brand-track { min-height: 70px; justify-content: flex-start; overflow-x: auto; }
    .home-block { padding: var(--space-section) 0; }
    .decision-grid, .content-cards { grid-template-columns: 1fr; }
    .guide-home-panel { padding: 24px; }
    .guide-home-actions { justify-items: stretch; min-width: 0; }
    .guide-home-actions a { text-align: center; }
    .content-card img { height: auto; aspect-ratio: 2.4 / 1; }
    .decision-card { min-height: 210px; }
    .service-card { grid-template-columns: 1fr; max-height: none; }
    .service-card > img { aspect-ratio: 16/10; }
    .diagnostic-panel, .case-card, .about-grid { grid-template-columns: 1fr; max-height: none; }
    .diagnostic-image { min-height: 280px; }
    .case-card > img { min-height: 260px; }
    .case-steps { grid-template-columns: 1fr; }
    .about-stats { grid-column: auto; grid-template-columns: 1fr; }
    .final-cta .home-container { align-items: stretch; flex-direction: column; }
    .final-actions { flex-direction: column; }
  }
</style>
