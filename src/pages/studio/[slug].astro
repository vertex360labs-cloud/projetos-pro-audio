---
import { getCollection } from 'astro:content';
import LandingLayout from '@/layouts/LandingLayout.astro';
import { studioPages, studioTopicKeywords } from '@/data/architecture';
import { includeBlogEntry, getRelatedPostsByKeywords } from '@/utils/blog';

export function getStaticPaths() {
  return studioPages.map((page) => ({ params: { slug: page.slug }, props: { page } }));
}

const { page } = Astro.props;
const posts = await getCollection('blog', includeBlogEntry);
const relatedArticles = getRelatedPostsByKeywords(posts, studioTopicKeywords[page.slug] ?? []).map((item) => ({
  title: item.data.title,
  href: `/blog/${item.id}`,
  description: item.data.description,
}));
---
<LandingLayout
  title={page.title}
  eyebrow="Studio"
  canonical={`/studio/${page.slug}`}
  description={page.description}
  intro={page.intro}
  image="/images/real/ssl2_site_ok-4ZKPyZ4V2xMcBfE4.jpg"
  imageAlt={page.title}
  bullets={page.bullets}
  relatedArticles={relatedArticles}
  cards={[
    { title: 'Analise seu setup', description: 'Identifique as prioridades do sistema antes de escolher novos equipamentos.', href: '/diagnostico-de-setup' },
    { title: 'Guias e análises', description: 'Consulte critérios de compra, aplicações e comparações técnicas.', href: '/conteudos' },
  ]}
/>
