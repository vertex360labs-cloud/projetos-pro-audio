---
import LandingLayout from '@/layouts/LandingLayout.astro';
import { studioPages } from '@/data/architecture';
---
<LandingLayout
  title="Studio"
  eyebrow="Estúdios profissionais"
  canonical="/studio"
  description="Decisões mais claras para montar, atualizar e integrar estúdios profissionais e home studios avançados."
  intro="Não existe uma sequência universal de upgrades. O ponto de partida é o trabalho que você realiza, o sistema atual, a sala e o que realmente limita o próximo resultado."
  image="/images/real/ssl900_site-OwEpoEGYUBs0ktyw.jpg"
  bullets={['Equipamentos pontuais ou projetos completos', 'Escolhas compatíveis com sua sala e rotina', 'Integração técnica e planejamento de expansão']}
  cards={studioPages.map((page) => ({ ...page, href: `/studio/${page.slug}` }))}
/>
