---
import LandingLayout from '@/layouts/LandingLayout.astro';
import { livePages } from '@/data/architecture';
export function getStaticPaths() {
  return livePages.map((page) => ({ params: { slug: page.slug }, props: { page } }));
}
const { page } = Astro.props;
const archived = ['wireless', 'projetos-de-sonorizacao'].includes(page.slug);
---
<LandingLayout
  title={page.title}
  eyebrow="Live Sound"
  canonical={`/live-sound/${page.slug}`}
  description={page.description}
  intro={page.intro}
  image="/images/expertise-theatre.jpg"
  bullets={page.bullets}
  noindex={archived}
  cards={[
    { title: 'Analise sua necessidade', description: 'Compartilhe o sistema atual, o ambiente e a aplicação desejada.', href: '/diagnostico-de-setup' },
    { title: 'Outras soluções para sonorização', description: 'Conheça opções para consoles, redes e monitoração.', href: '/live-sound' },
    { title: 'Guias e análises', description: 'Consulte informações técnicas para planejar sua operação.', href: '/conteudos' },
  ]}
/>
