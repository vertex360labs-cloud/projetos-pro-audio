---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Breadcrumb from '@/components/Breadcrumb.astro';
import CTA from '@/components/CTA.astro';
---
<BaseLayout title="Contato" description="Entre em contato com o Projetos Pro Audio para Studio, Live Sound, igrejas, eventos e projetos." canonical="/contato">
  <header class="page-hero"><div class="container"><Breadcrumb items={[{label:'Início',href:'/'},{label:'Contato'}]}/><span class="eyebrow">Contato</span><h1 class="title-lg">Conte o que você precisa resolver</h1><p class="lead">Envie as informações do seu estúdio, sistema de sonorização ou projeto. Rodrigo fará o primeiro contato e, quando necessário, envolverá a equipe técnica adequada.</p></div></header>
  <CTA eyebrow="Envie sua necessidade" title="Vamos conversar sobre o seu sistema" />
</BaseLayout>
