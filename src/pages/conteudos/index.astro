---
import { getCollection } from 'astro:content';
import BaseLayout from '@/layouts/BaseLayout.astro';
import Breadcrumb from '@/components/Breadcrumb.astro';
const posts = (await getCollection('blog', ({ data }) => !data.draft)).sort((a,b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
const pillars = [
  ['Análises técnicas', 'Entenda aplicações, integrações e pontos de atenção antes de escolher um equipamento.', '/reviews'],
  ['Guia de Equipamentos', 'Produtos organizados por aplicação, critérios de escolha e próximo passo.', '/guia-de-equipamentos'],
];
---
<BaseLayout title="Conteúdos" description="Guias e análises para escolher, integrar e utilizar equipamentos profissionais de áudio." canonical="/conteudos">
  <header class="page-hero"><div class="container"><Breadcrumb items={[{label:'Início',href:'/'},{label:'Conteúdos'}]} /><span class="eyebrow">Biblioteca técnica</span><h1 class="title-lg">Conteúdo para decidir melhor.</h1><p class="lead">Informação técnica aplicada a compra, integração, operação e evolução de sistemas profissionais de áudio.</p></div></header>
  <section class="section section-alt"><div class="container"><div class="card-grid">{pillars.map(([title,description,href],i)=><article class="card card-body"><span class="card-icon">{String(i+1).padStart(2,'0')}</span><h3>{title}</h3><p>{description}</p><a class="text-link" href={href}>Explorar</a></article>)}</div></div></section>
  <section class="section"><div class="container"><div class="section-heading"><span class="eyebrow">Artigos recentes</span><h2>Guias e análises</h2></div><div class="blog-grid">{posts.map(post=><a class="card blog-card" href={`/blog/${post.id}`}>{post.data.heroImage&&<div class="blog-card-image"><img src={post.data.heroImage} alt="" width="640" height="360" loading="lazy"/></div>}<div class="blog-card-body"><span class="tag">Conteúdo técnico</span><h3>{post.data.title}</h3><p>{post.data.description}</p></div></a>)}</div></div></section>
</BaseLayout>
