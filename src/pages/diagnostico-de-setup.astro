---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Breadcrumb from '@/components/Breadcrumb.astro';
import CTA from '@/components/CTA.astro';
---
<BaseLayout title="Diagnóstico de Setup" description="Organize o cenário atual, identifique gargalos e dê o primeiro passo para o próximo upgrade ou projeto." canonical="/diagnostico-de-setup">
  <header class="page-hero"><div class="container"><Breadcrumb items={[{label:'Início',href:'/'},{label:'Diagnóstico de Setup'}]}/><span class="eyebrow">Ponto de partida</span><h1 class="title-lg">Antes de escolher, entenda o que limita o sistema</h1><p class="lead">Compartilhe os equipamentos que utiliza, as características do ambiente e o resultado que procura. A análise começa pela sua operação, não por uma lista pronta de produtos.</p></div></header>
  <section class="section-sm"><div class="container stat-grid"><div class="stat"><strong>1. Sistema atual</strong><span>Operação, equipamentos e características do ambiente.</span></div><div class="stat"><strong>2. Principal dificuldade</strong><span>O que compromete o resultado, a agilidade ou a confiabilidade.</span></div><div class="stat"><strong>3. Próximo passo</strong><span>Prioridades para orientar a conversa e as escolhas.</span></div></div></section>
  <CTA eyebrow="Formulário de diagnóstico" title="Conte como o seu sistema funciona hoje" description="Com essas informações, a primeira conversa pode se concentrar no que realmente precisa ser resolvido." />
</BaseLayout>
