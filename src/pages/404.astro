---
import BaseLayout from '@/layouts/BaseLayout.astro';
---
<BaseLayout title="Página não encontrada" description="A página solicitada não foi encontrada." noindex>
  <main class="section"><div class="container empty-state"><span class="eyebrow">Erro 404</span><h1 class="title-lg">Este endereço não está aqui.</h1><p class="lead" style="margin-inline:auto;">O conteúdo pode ter mudado de lugar. Use os caminhos abaixo para continuar.</p><div class="btn-row" style="justify-content:center;"><a class="btn btn-primary" href="/">Ir para a Home</a><a class="btn btn-secondary" href="/conteudos">Ver conteúdos</a></div></div></main>
</BaseLayout>
