---
import { getCollection, render } from 'astro:content';
import { includeBlogEntry, pickRelatedPosts } from '@/utils/blog';
import ArticleLayout from '@/layouts/ArticleLayout.astro';
import { getReadingTime } from '@/utils/reading-time';

export async function getStaticPaths() {
  const posts = await getCollection('blog', includeBlogEntry);
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content, headings } = await render(post);
const readingTime = getReadingTime(post.body ?? '');
const slug = `/blog/${post.id}`;
const canonical = post.data.canonical ?? slug;

const allPosts = await getCollection('blog', includeBlogEntry);
const related = pickRelatedPosts(post, allPosts);

const toc = headings
  .filter((heading) => heading.depth >= 2 && heading.depth <= 3)
  .map((heading) => ({
    id: heading.slug,
    text: heading.text,
    level: heading.depth,
  }));
---

<ArticleLayout
  title={post.data.title}
  description={post.data.description}
  slug={slug}
  canonical={canonical}
  author={post.data.author}
  pubDate={post.data.pubDate}
  updatedDate={post.data.updatedDate}
  readingTime={readingTime}
  heroImage={post.data.heroImage}
  heroImageAlt={post.data.title}
  tags={post.data.tags}
  breadcrumbs={[
    { label: 'Início', href: '/' },
    { label: 'Conteúdos', href: '/conteudos' },
    { label: post.data.title },
  ]}
  toc={toc}
  relatedArticles={related.map((item) => ({
    title: item.data.title,
    href: `/blog/${item.id}`,
    description: item.data.description,
  }))}
>
  <Content />
</ArticleLayout>
