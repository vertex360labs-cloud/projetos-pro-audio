---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Breadcrumb from '@/components/Breadcrumb.astro';
import { SITE } from '@/config/site';
import { equipmentCategories, equipmentCount, guideEquipment, type GuideEquipment } from '@/data/equipment-guide';
import { breadcrumbSchema } from '@/utils/schema';

const fullName = (item: GuideEquipment) =>
  item.name.toLowerCase().startsWith(item.brand.toLowerCase()) ? item.name : `${item.brand} ${item.name}`;

const whatsappFor = (item: GuideEquipment) =>
  `https://wa.me/${SITE.contact.whatsapp}?text=${encodeURIComponent(`Olá, Rodrigo. Vi o ${fullName(item)} no Guia de Equipamentos e gostaria de saber mais.`)}`;

const formFor = (item: GuideEquipment, diagnostic = false) => {
  const path = diagnostic ? '/diagnostico-de-setup' : '/contato';
  return `${path}?produto=${encodeURIComponent(fullName(item))}&categoria=${encodeURIComponent(equipmentCategories[item.category].label)}`;
};

const actionFor = (item: GuideEquipment) => {
  if (item.action === 'buy' && item.purchaseUrl) return { href: item.purchaseUrl, label: 'Comprar', external: true };
  if (item.action === 'buy') return { href: whatsappFor(item), label: 'Pedir link de compra', external: true };
  if (item.action === 'whatsapp') return { href: whatsappFor(item), label: 'Falar no WhatsApp', external: true };
  if (item.action === 'diagnostic') return { href: formFor(item, true), label: 'Analisar meu sistema', external: false };
  return { href: formFor(item), label: 'Enviar interesse', external: false };
};

const categoryOptions = Object.entries(equipmentCategories);
const schema = [
  breadcrumbSchema([
    { label: 'Início', href: '/' },
    { label: 'Guia de Equipamentos', href: '/guia-de-equipamentos' },
  ]),
  {
    '@context': 'https://schema.org',
    '@type': 'ItemList',
    name: 'Guia de Equipamentos — Projetos Pro Audio',
    numberOfItems: equipmentCount,
    itemListElement: guideEquipment.map((item, index) => ({
      '@type': 'ListItem',
      position: index + 1,
      name: fullName(item),
      url: `${SITE.url}/guia-de-equipamentos#${item.id}`,
    })),
  },
];
---

<BaseLayout
  title="Guia de Equipamentos para Studio e Live Sound"
  description="Encontre interfaces, monitores, outboard, microfones, controladores e consoles de acordo com sua aplicação e o próximo passo do seu sistema."
  canonical="/guia-de-equipamentos"
  schema={schema}
>
  <main class="equipment-guide">
    <header class="guide-hero">
      <div class="container guide-hero-grid">
        <div>
          <Breadcrumb items={[{ label: 'Início', href: '/' }, { label: 'Guia de Equipamentos' }]} />
          <span class="eyebrow">Escolha por aplicação</span>
          <h1>Equipamentos que fazem sentido dentro do seu sistema.</h1>
          <p class="lead">Use os filtros para comparar caminhos de Studio e Live Sound. Cada indicação mostra para quem o produto faz sentido, onde costuma ser aplicado e o que precisa ser conferido antes da decisão.</p>
          <div class="btn-row">
            <a class="btn btn-primary" href="#equipamentos">Explorar equipamentos</a>
            <a class="btn btn-secondary" href="/diagnostico-de-setup">Analisar meu setup</a>
          </div>
        </div>
        <aside class="guide-principles" aria-label="Como usar o guia">
          <span class="eyebrow">Antes de escolher</span>
          <ol>
            <li><strong>Comece pela aplicação.</strong><span>O trabalho e o ambiente definem a prioridade.</span></li>
            <li><strong>Confira a integração.</strong><span>I/O, sala, rede e expansão fazem parte da compra.</span></li>
            <li><strong>Escolha o próximo passo.</strong><span>Compra, conversa ou diagnóstico conforme a complexidade.</span></li>
          </ol>
        </aside>
      </div>
    </header>

    <section class="guide-section guide-intro">
      <div class="container">
        <div class="section-heading center">
          <span class="eyebrow">Do home studio ao sistema profissional</span>
          <h2>Encontre um ponto de partida</h2>
          <p>O guia não é um ranking universal. Ele organiza opções para diferentes cenários e conecta cada escolha ao conteúdo ou atendimento adequado.</p>
        </div>
        <div class="guide-category-links">
          {categoryOptions.map(([key, category]) => (
            <button type="button" class="category-shortcut" data-category-shortcut={key}>
              <strong>{category.label}</strong>
              <span>{category.intro}</span>
            </button>
          ))}
        </div>
      </div>
    </section>

    <section class="guide-section equipment-browser" id="equipamentos">
      <div class="container">
        <div class="browser-heading">
          <div>
            <span class="eyebrow">Seleção inicial</span>
            <h2>{equipmentCount} produtos e linhas prioritárias</h2>
          </div>
          <p id="resultCount" aria-live="polite">Mostrando {equipmentCount} opções</p>
        </div>

        <div class="guide-controls" aria-label="Filtros do guia">
          <label class="guide-search">
            <span>Buscar</span>
            <input id="equipmentSearch" type="search" placeholder="Produto, marca ou aplicação" autocomplete="off" />
          </label>
          <label>
            <span>Categoria</span>
            <select id="categoryFilter">
              <option value="all">Todas as categorias</option>
              {categoryOptions.map(([key, category]) => <option value={key}>{category.label}</option>)}
            </select>
          </label>
          <label>
            <span>Tipo de projeto</span>
            <select id="destinationFilter">
              <option value="all">Todos</option>
              <option value="studio">Studio e produção</option>
              <option value="live">Live Sound</option>
            </select>
          </label>
          <button id="clearFilters" type="button" class="btn btn-secondary">Limpar filtros</button>
        </div>

        <div class="equipment-grid" id="equipmentGrid">
          {guideEquipment.map((item) => {
            const action = actionFor(item);
            const projectType = item.category === 'consoles-live' ? 'live' : 'studio';
            const searchable = `${item.name} ${item.brand} ${item.profile} ${item.application} ${equipmentCategories[item.category].label}`.toLowerCase();
            return (
              <article
                class:list={['equipment-card', { featured: item.featured }]}
                id={item.id}
                data-equipment-card
                data-category={item.category}
                data-project={projectType}
                data-search={searchable}
              >
                <div class="equipment-card-head">
                  <div>
                    <span class="equipment-brand">{item.brand}</span>
                    <h3>{item.name}</h3>
                  </div>
                  {item.featured && <span class="priority-badge">Em destaque</span>}
                </div>
                <span class="equipment-category">{equipmentCategories[item.category].label}</span>
                <dl class="equipment-details">
                  <div><dt>Indicado para</dt><dd>{item.profile}</dd></div>
                  <div><dt>Aplicação</dt><dd>{item.application}</dd></div>
                  <div><dt>Antes de decidir</dt><dd>{item.attention}</dd></div>
                </dl>
                <div class="equipment-actions">
                  <a
                    class="btn btn-primary"
                    href={action.href}
                    target={action.external ? '_blank' : undefined}
                    rel={action.external ? 'noopener noreferrer' : undefined}
                    data-equipment-action
                    data-product={fullName(item)}
                    data-action={item.action}
                  >{action.label}</a>
                  {(item.action === 'whatsapp' || item.action === 'buy') && (
                    <a
                      class="form-fallback-link"
                      href={formFor(item)}
                      data-equipment-action
                      data-product={fullName(item)}
                      data-action="formulario"
                    >Prefiro enviar um formulário</a>
                  )}
                  {item.relatedUrl && <a class="details-link" href={item.relatedUrl}>Ver conteúdo relacionado →</a>}
                </div>
              </article>
            );
          })}
        </div>
        <div id="emptyResults" class="empty-results" hidden>
          <h3>Nenhum equipamento encontrado</h3>
          <p>Tente outro termo ou remova os filtros. Se preferir, envie seu cenário para uma análise.</p>
          <a class="btn btn-primary" href="/diagnostico-de-setup">Analisar meu setup</a>
        </div>
        <p class="commercial-note">A disponibilidade, os preços e as condições podem mudar. Alguns destinos de compra podem utilizar links de afiliado, sem alteração no preço para o comprador. Confirme os dados no momento da compra.</p>
      </div>
    </section>

    <section class="guide-section guide-paths">
      <div class="container">
        <div class="section-heading center">
          <span class="eyebrow">Próximo passo</span>
          <h2>Nem toda escolha precisa do mesmo atendimento</h2>
        </div>
        <div class="path-grid">
          <article><strong>Comprar</strong><p>Para produtos simples, disponíveis e com destino de compra confirmado.</p></article>
          <article><strong>WhatsApp</strong><p>Para intenção imediata, dúvidas objetivas e equipamentos de maior valor agregado.</p></article>
          <article><strong>Formulário</strong><p>Para quem prefere enviar as informações agora e receber retorno depois.</p></article>
          <article><strong>Diagnóstico</strong><p>Para decisões que dependem de sala, infraestrutura, integração ou setup.</p></article>
        </div>
      </div>
    </section>
  </main>
</BaseLayout>

<script>
  const search = document.querySelector<HTMLInputElement>('#equipmentSearch');
  const category = document.querySelector<HTMLSelectElement>('#categoryFilter');
  const destination = document.querySelector<HTMLSelectElement>('#destinationFilter');
  const clear = document.querySelector<HTMLButtonElement>('#clearFilters');
  const cards = [...document.querySelectorAll<HTMLElement>('[data-equipment-card]')];
  const resultCount = document.querySelector('#resultCount');
  const emptyResults = document.querySelector<HTMLElement>('#emptyResults');

  const normalize = (value: string) => value.normalize('NFD').replace(/[\u0300-\u036f]/g, '').toLowerCase().trim();

  const applyFilters = () => {
    const term = normalize(search?.value ?? '');
    const selectedCategory = category?.value ?? 'all';
    const selectedDestination = destination?.value ?? 'all';
    let visible = 0;

    cards.forEach((card) => {
      const matchesSearch = !term || normalize(card.dataset.search ?? '').includes(term);
      const matchesCategory = selectedCategory === 'all' || card.dataset.category === selectedCategory;
      const matchesDestination = selectedDestination === 'all' || card.dataset.project === selectedDestination;
      const matches = matchesSearch && matchesCategory && matchesDestination;
      card.hidden = !matches;
      if (matches) visible += 1;
    });

    if (resultCount) resultCount.textContent = `Mostrando ${visible} ${visible === 1 ? 'opção' : 'opções'}`;
    if (emptyResults) emptyResults.hidden = visible !== 0;
    window.ppaTrack?.('equipment_filter', { categoria: selectedCategory, projeto: selectedDestination, busca: term ? 'sim' : 'nao' });
  };

  search?.addEventListener('input', applyFilters);
  category?.addEventListener('change', applyFilters);
  destination?.addEventListener('change', applyFilters);
  clear?.addEventListener('click', () => {
    if (search) search.value = '';
    if (category) category.value = 'all';
    if (destination) destination.value = 'all';
    applyFilters();
  });

  document.querySelectorAll<HTMLButtonElement>('[data-category-shortcut]').forEach((button) => {
    button.addEventListener('click', () => {
      if (category) category.value = button.dataset.categoryShortcut ?? 'all';
      applyFilters();
      document.querySelector('#equipamentos')?.scrollIntoView({ behavior: 'smooth' });
    });
  });

  document.querySelectorAll<HTMLAnchorElement>('[data-equipment-action]').forEach((link) => {
    link.addEventListener('click', () => {
      window.ppaTrack?.('equipment_action', {
        produto: link.dataset.product,
        acao: link.dataset.action,
        origem: window.location.pathname,
      });
    });
  });
</script>

<style>
  .equipment-guide { background: #f6f6f3; color: #111517; }
  .guide-hero { padding: 58px 0; border-bottom: 1px solid #d7d7d2; background: #f8f8f6; }
  .guide-hero-grid { display: grid; grid-template-columns: minmax(0, 1.4fr) minmax(320px, .6fr); gap: 54px; align-items: center; }
  .guide-hero h1 { max-width: 14ch; margin-top: 12px; font-size: clamp(2.75rem, 5vw, 4.8rem); line-height: .98; letter-spacing: -.06em; }
  .guide-hero .lead { max-width: 67ch; }
  .guide-principles { padding: 28px; border: 1px solid #d4d4d0; border-radius: 6px; background: #fff; box-shadow: 0 20px 50px rgba(17, 21, 23, .07); }
  .guide-principles ol { display: grid; gap: 20px; margin-top: 20px; padding: 0; list-style: none; counter-reset: guide-step; }
  .guide-principles li { display: grid; grid-template-columns: 34px 1fr; column-gap: 12px; counter-increment: guide-step; }
  .guide-principles li::before { content: counter(guide-step, decimal-leading-zero); grid-row: 1 / 3; color: #23628d; font-weight: 850; }
  .guide-principles strong, .guide-principles span { grid-column: 2; }
  .guide-principles span { margin-top: 3px; color: #666b6d; font-size: .9rem; line-height: 1.5; }
  .guide-section { padding: 62px 0; border-bottom: 1px solid #dddcd7; }
  .section-heading.center { max-width: 720px; margin: 0 auto 30px; text-align: center; }
  .section-heading.center p { margin-inline: auto; }
  .guide-category-links { display: grid; grid-template-columns: repeat(3, 1fr); gap: 14px; }
  .category-shortcut { min-height: 150px; padding: 22px; border: 1px solid #d4d4d0; border-radius: 5px; background: #fff; color: inherit; text-align: left; cursor: pointer; transition: transform .2s, border-color .2s, box-shadow .2s; }
  .category-shortcut:hover, .category-shortcut:focus-visible { border-color: #23628d; box-shadow: 0 12px 30px rgba(17,21,23,.07); transform: translateY(-2px); }
  .category-shortcut strong { display: block; font-size: 1.08rem; }
  .category-shortcut span { display: block; margin-top: 9px; color: #666b6d; font-size: .9rem; line-height: 1.5; }
  .equipment-browser { background: #fff; }
  .browser-heading { display: flex; justify-content: space-between; gap: 24px; align-items: end; margin-bottom: 24px; }
  .browser-heading h2 { margin-top: 5px; font-size: clamp(2rem, 3vw, 2.8rem); letter-spacing: -.045em; }
  #resultCount { color: #666b6d; font-size: .9rem; font-weight: 700; }
  .guide-controls { display: grid; grid-template-columns: 1.5fr 1fr 1fr auto; gap: 12px; align-items: end; margin-bottom: 26px; padding: 16px; border: 1px solid #d7d7d2; border-radius: 5px; background: #f6f6f3; }
  .guide-controls label { display: grid; gap: 6px; }
  .guide-controls label span { font-size: .72rem; font-weight: 850; letter-spacing: .045em; text-transform: uppercase; }
  .guide-controls input, .guide-controls select { width: 100%; min-height: 44px; border: 1px solid #c8c8c3; border-radius: 4px; padding: 0 12px; background: #fff; color: #111517; font: inherit; }
  .guide-controls .btn { min-height: 44px; white-space: nowrap; }
  .equipment-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 16px; }
  .equipment-card { display: flex; flex-direction: column; min-height: 465px; padding: 23px; border: 1px solid #d7d7d2; border-radius: 5px; background: #fff; }
  .equipment-card.featured { border-top: 3px solid #23628d; padding-top: 21px; }
  .equipment-card[hidden] { display: none; }
  .equipment-card-head { display: flex; justify-content: space-between; gap: 14px; align-items: start; }
  .equipment-brand { color: #23628d; font-size: .7rem; font-weight: 900; letter-spacing: .07em; text-transform: uppercase; }
  .equipment-card h3 { margin-top: 4px; font-size: 1.55rem; letter-spacing: -.035em; }
  .priority-badge { flex: 0 0 auto; padding: 5px 8px; border-radius: 999px; background: #e9f1f6; color: #194f73; font-size: .65rem; font-weight: 850; text-transform: uppercase; }
  .equipment-category { margin-top: 12px; color: #666b6d; font-size: .8rem; }
  .equipment-details { display: grid; gap: 14px; margin: 22px 0; }
  .equipment-details div { padding-top: 13px; border-top: 1px solid #e3e3df; }
  .equipment-details dt { color: #303537; font-size: .7rem; font-weight: 850; letter-spacing: .04em; text-transform: uppercase; }
  .equipment-details dd { margin: 5px 0 0; color: #666b6d; font-size: .88rem; line-height: 1.5; }
  .equipment-actions { display: grid; gap: 11px; margin-top: auto; }
  .equipment-actions .btn { width: 100%; }
  .details-link { color: #245f86; font-size: .82rem; font-weight: 750; text-align: center; }
  .form-fallback-link { color: #303537; font-size: .8rem; font-weight: 750; text-align: center; text-decoration: underline; text-underline-offset: 3px; }
  .empty-results { padding: 50px; border: 1px dashed #b9b9b4; border-radius: 5px; text-align: center; }
  .empty-results p { margin: 10px auto 20px; color: #666b6d; }
  .commercial-note { max-width: 90ch; margin: 28px auto 0; color: #747879; font-size: .76rem; line-height: 1.5; text-align: center; }
  .path-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 14px; }
  .path-grid article { padding: 22px; border: 1px solid #d4d4d0; border-radius: 5px; background: #fff; }
  .path-grid strong { font-size: 1.05rem; }
  .path-grid p { margin-top: 8px; color: #666b6d; font-size: .9rem; line-height: 1.55; }
  @media (max-width: 980px) {
    .guide-hero-grid { grid-template-columns: 1fr; }
    .guide-category-links, .equipment-grid { grid-template-columns: repeat(2, 1fr); }
    .guide-controls { grid-template-columns: 1fr 1fr; }
    .path-grid { grid-template-columns: repeat(2, 1fr); }
  }
  @media (max-width: 640px) {
    .guide-hero { padding: 38px 0; }
    .guide-hero h1 { font-size: 2.8rem; }
    .guide-hero-grid { gap: 30px; }
    .guide-section { padding: 44px 0; }
    .guide-category-links, .equipment-grid, .guide-controls, .path-grid { grid-template-columns: 1fr; }
    .browser-heading { display: grid; }
    .equipment-card { min-height: 0; }
    .guide-controls .btn { width: 100%; }
  }
</style>
