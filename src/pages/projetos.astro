---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Breadcrumb from '@/components/Breadcrumb.astro';
import CTA from '@/components/CTA.astro';
const examples = [
  ['Integração SSL', '/images/real/projetos-ssl-swa-948-delta-Bf7ipliE8L0dOPSu.jpg', 'Planejamento de superfície, interfaces, cabeamento e workflow como partes do mesmo sistema.'],
  ['Podcast e produção', '/images/real/rodrigo-podcast-blm5RXanrJM9tVIo.jpg', 'Estruturas pensadas para captação consistente e operação recorrente.'],
  ['Cabeamento e infraestrutura', '/images/real/cabeamento-redco-mogami-para-estudios-EqZymYEyaSWho9o9.png', 'Conexão e organização que sustentam expansão, manutenção e confiabilidade.'],
];
---
<BaseLayout noindex title="Projetos e Setups" description="Projetos, integrações e setups profissionais de áudio acompanhados pelo Projetos Pro Audio." canonical="/projetos">
  <header class="page-hero"><div class="container"><Breadcrumb items={[{label:'Início',href:'/'},{label:'Projetos'}]}/><span class="eyebrow">Integração de sistemas</span><h1 class="title-lg">Projetos e configurações de áudio</h1><p class="lead">Veja como monitoração, conversão, controle, cabeamento e captação podem ser organizados para tornar a operação mais prática e preparada para expansão.</p></div></header>
  <section class="section"><div class="container"><div class="card-grid">{examples.map(([title,image,description])=><article class="card"><div class="blog-card-image"><img src={image} alt="" width="720" height="405" loading="lazy"/></div><div class="card-body"><h3>{title}</h3><p>{description}</p></div></article>)}</div></div></section>
  <CTA title="Tem um projeto ou setup para analisar?" />
</BaseLayout>
