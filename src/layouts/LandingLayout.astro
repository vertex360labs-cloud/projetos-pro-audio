---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Breadcrumb from '@/components/Breadcrumb.astro';
import CTA from '@/components/CTA.astro';
import { breadcrumbSchema } from '@/utils/schema';

interface Card { title: string; description: string; href?: string; label?: string; }
interface Props {
  title: string;
  description: string;
  canonical: string;
  eyebrow: string;
  intro?: string;
  image?: string;
  imageAlt?: string;
  cards?: Card[];
  bullets?: string[];
  ctaTitle?: string;
  noindex?: boolean;
}

const {
  title, description, canonical, eyebrow, intro, image, imageAlt = '',
  cards = [], bullets = [], ctaTitle, noindex = false,
} = Astro.props;
const crumbs = [
  { label: 'Início', href: '/' },
  { label: title },
];
---

<BaseLayout title={title} description={description} canonical={canonical} schema={breadcrumbSchema(crumbs)} noindex={noindex}>
  <header class="page-hero">
    <div class="container">
      <Breadcrumb items={crumbs} />
      <span class="eyebrow">{eyebrow}</span>
      <h1 class="title-lg">{title}</h1>
      <p class="lead">{description}</p>
    </div>
  </header>

  {intro && (
    <section class="section">
      <div class="container split">
        <div class="split-copy">
          <h2>O que considerar antes de escolher</h2>
          <p>{intro}</p>
          {bullets.length > 0 && <ul class="check-list">{bullets.map((bullet) => <li>{bullet}</li>)}</ul>}
        </div>
        {image && <div class="split-media"><img src={image} alt={imageAlt} width="900" height="680" loading="eager" /></div>}
      </div>
    </section>
  )}

  {cards.length > 0 && (
    <section class="section section-alt">
      <div class="container">
        <div class="section-heading">
          <span class="eyebrow">Veja também</span>
          <h2>Encontre a solução adequada para sua necessidade</h2>
        </div>
        <div class="card-grid">
          {cards.map((card, index) => (
            <article class="card card-body">
              <span class="card-icon">{card.label ?? String(index + 1).padStart(2, '0')}</span>
              <h3>{card.title}</h3>
              <p>{card.description}</p>
              {card.href && <a class="text-link" href={card.href}>Saiba mais</a>}
            </article>
          ))}
        </div>
      </div>
    </section>
  )}

  <slot />
  <CTA title={ctaTitle ?? `Quer conversar sobre ${title}?`} />
</BaseLayout>
