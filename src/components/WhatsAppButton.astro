---
import { SITE } from '@/config/site';

const message = 'Olá, Rodrigo! Vim pelo site Projetos Pro Audio e gostaria de conversar.';
const whatsappUrl = `https://wa.me/${SITE.contact.whatsapp}?text=${encodeURIComponent(message)}`;
---

<a
  class="whatsapp-button"
  href={whatsappUrl}
  target="_blank"
  rel="noopener noreferrer"
  aria-label="Falar com Rodrigo pelo WhatsApp"
  data-whatsapp-button
>
  <svg aria-hidden="true" viewBox="0 0 32 32" width="25" height="25">
    <path fill="currentColor" d="M16.04 3A12.78 12.78 0 0 0 5.18 22.52L3.5 28.65l6.28-1.65A12.77 12.77 0 1 0 16.04 3Zm0 23.4c-1.95 0-3.86-.53-5.52-1.53l-.4-.24-3.72.98 1-3.63-.26-.42a10.62 10.62 0 1 1 8.9 4.84Zm5.82-7.96c-.32-.16-1.89-.93-2.18-1.04-.3-.1-.51-.16-.72.16-.21.32-.83 1.04-1.02 1.25-.18.21-.37.24-.69.08-.32-.16-1.34-.5-2.55-1.57a9.57 9.57 0 0 1-1.77-2.2c-.18-.32-.02-.49.14-.65.14-.14.32-.37.48-.56.16-.18.21-.32.32-.53.1-.21.05-.4-.03-.56-.08-.16-.72-1.73-.99-2.37-.26-.62-.52-.54-.72-.55h-.61c-.21 0-.56.08-.85.4-.29.32-1.12 1.09-1.12 2.66s1.15 3.09 1.31 3.3c.16.21 2.25 3.43 5.45 4.81.76.33 1.36.52 1.82.67.77.24 1.46.21 2.01.13.61-.09 1.89-.77 2.16-1.52.27-.74.27-1.38.19-1.52-.08-.13-.29-.21-.61-.37Z"/>
  </svg>
  <span>Fale pelo WhatsApp</span>
</a>

<script>
  document.querySelector('[data-whatsapp-button]')?.addEventListener('click', () => {
    window.ppaTrack?.('whatsapp_click', { origem: window.location.pathname });
  });
</script>
