---
import { SITE } from '@/config/site';

interface Props {
  author?: string;
  role?: string;
  bio?: string;
}

const {
  author = SITE.author.name,
  role = SITE.author.role,
  bio = SITE.author.bio,
} = Astro.props;

---

<aside class="author-box card" aria-label="Sobre o autor">
  <img class="author-photo" src="/images/rodrigo-assinatura.webp" alt="Rodrigo Chiacchio" width="82" height="82" loading="lazy" />
  <div>
    <h3 class="title-md" style="font-size:1rem;">{author}</h3>
    <p class="muted" style="margin-top:6px; font-size:.88rem;">{role}</p>
    <p class="muted" style="margin-top:10px;">{bio}</p>
  </div>
</aside>
