---
interface Props {
  eyebrow?: string;
  title?: string;
  description?: string;
  showForm?: boolean;
  compact?: boolean;
}

const {
  eyebrow = 'Converse com um especialista',
  title = 'Qual é o próximo passo para o seu sistema?',
  description = 'Conte como você trabalha hoje, o que está limitando a operação e o resultado que procura. Essas informações ajudam a tornar a primeira conversa mais objetiva.',
  showForm = true,
  compact = false,
} = Astro.props;

const selectedProduct = Astro.url.searchParams.get('produto') ?? '';
const selectedCategory = Astro.url.searchParams.get('categoria') ?? '';
---

<section class:list={['section', 'cta-section', { 'cta-compact': compact }]} id="contato">
  <div class="container">
    <div class="cta-panel">
      <div class="cta-intro">
        <span class="eyebrow">{eyebrow}</span>
        <h2>{title}</h2>
        <p>{description}</p>
        <ul class="check-list">
          <li>Análise do sistema e da aplicação</li>
          <li>Orientação de acordo com sua necessidade</li>
          <li>Conversa inicial sem compromisso de compra</li>
        </ul>
      </div>

      {showForm && (
        <form id="leadForm" class="contact-form" action="/api/lead" method="post" novalidate>
          <div class="form-grid">
            <div class="field">
              <label for="nome">Nome *</label>
              <input id="nome" name="nome" autocomplete="name" required />
            </div>
            <div class="field">
              <label for="empresa">Empresa ou estúdio</label>
              <input id="empresa" name="empresa" autocomplete="organization" />
            </div>
            <div class="field">
              <label for="whatsapp">WhatsApp *</label>
              <input id="whatsapp" name="whatsapp" type="tel" autocomplete="tel" required />
            </div>
            <div class="field">
              <label for="email">E-mail *</label>
              <input id="email" name="email" type="email" autocomplete="email" required />
            </div>
            <div class="field">
              <label for="interesse">Área de interesse *</label>
              <select id="interesse" name="interesse" required>
                <option value="">Selecione</option>
                <option value="studio">Studio</option>
                <option value="live-sound">Live Sound</option>
                <option value="igreja">Igreja</option>
                <option value="eventos-locacao">Eventos / locação</option>
                <option value="podcast-broadcast">Podcast / broadcast</option>
                <option value="interfaces">Interfaces e conversão</option>
                <option value="monitoracao">Monitoração</option>
                <option value="outboard">Outboard e setup híbrido</option>
                <option value="microfones">Microfones e captação</option>
                <option value="producao">Controladores e produção</option>
                <option value="outro">Outro</option>
              </select>
            </div>
            <div class="field">
              <label for="operacao">Tipo de operação</label>
              <input id="operacao" name="operacao" placeholder="Gravação, mixagem, culto, evento..." />
            </div>
            <div class="field">
              <label for="investimento">Faixa de investimento</label>
              <select id="investimento" name="investimento">
                <option value="">Selecione</option>
                <option>Até R$ 5 mil</option>
                <option>R$ 5 mil a R$ 15 mil</option>
                <option>R$ 15 mil a R$ 30 mil</option>
                <option>R$ 30 mil a R$ 60 mil</option>
                <option>R$ 60 mil a R$ 100 mil</option>
                <option>Acima de R$ 100 mil</option>
                <option>Ainda estou planejando</option>
              </select>
            </div>
            <div class="field">
              <label for="prazo">Prazo</label>
              <select id="prazo" name="prazo">
                <option value="">Selecione</option>
                <option>Imediato</option>
                <option>Até 3 meses</option>
                <option>3 a 6 meses</option>
                <option>6 a 12 meses</option>
                <option>Ainda sem prazo</option>
              </select>
            </div>
            <div class="field">
              <label for="produto">Produto ou linha de interesse</label>
              <input id="produto" name="produto" value={selectedProduct} placeholder="Se já tiver algo em mente" />
            </div>
            <div class="field">
              <label for="canalPreferido">Como prefere receber o retorno?</label>
              <select id="canalPreferido" name="canalPreferido">
                <option value="">Sem preferência</option>
                <option value="whatsapp">WhatsApp</option>
                <option value="email">E-mail</option>
              </select>
            </div>
            <div class="field field-full">
              <label for="cidade">Cidade / Estado</label>
              <input id="cidade" name="cidade" autocomplete="address-level2" />
            </div>
            <div class="field field-full">
              <label for="equipamentos">Equipamentos atuais</label>
              <textarea id="equipamentos" name="equipamentos" rows="3" placeholder="Liste os principais itens do sistema atual"></textarea>
            </div>
            <div class="field field-full">
              <label for="cenario">Principal dificuldade e objetivo *</label>
              <textarea id="cenario" name="cenario" rows="5" required placeholder="O que está limitando o sistema hoje e que resultado você procura?"></textarea>
            </div>
          </div>

          <div class="field-honeypot" aria-hidden="true">
            <label for="website">Não preencha</label>
            <input id="website" name="website" tabindex="-1" autocomplete="off" />
          </div>

          <label class="consent">
            <input type="checkbox" name="consentimento" value="sim" required />
            <span>Concordo com o uso destes dados para responder ao meu contato, conforme a <a href="/politica-de-privacidade" target="_blank" rel="noopener noreferrer">Política de Privacidade</a>.</span>
          </label>

          <input type="hidden" name="origem" value={Astro.url.pathname} />
          <input type="hidden" name="categoriaOrigem" value={selectedCategory} />
          <input type="hidden" name="referencia" value="" data-lead-referrer />
          <button type="submit" class="btn btn-primary">Enviar informações</button>
          <p class="form-note">Seus dados não serão vendidos. O contato poderá ser encaminhado a uma equipe técnica parceira quando isso for necessário para o atendimento.</p>
          <div id="formStatus" class="form-status" role="status" aria-live="polite"></div>
        </form>
      )}
    </div>
  </div>
</section>

<script>
  const leadForm = document.getElementById('leadForm') as HTMLFormElement | null;
  const formStatus = document.getElementById('formStatus');
  const referrerInput = leadForm?.querySelector<HTMLInputElement>('[data-lead-referrer]');
  if (referrerInput) referrerInput.value = document.referrer;
  let formStarted = false;
  leadForm?.addEventListener('input', () => {
    if (formStarted) return;
    formStarted = true;
    window.ppaTrack?.('lead_start', {
      origem: leadForm.querySelector<HTMLInputElement>('[name="origem"]')?.value,
      produto: leadForm.querySelector<HTMLInputElement>('[name="produto"]')?.value,
    });
  });

  leadForm?.addEventListener('submit', async (event) => {
    event.preventDefault();
    if (!leadForm.checkValidity()) {
      leadForm.reportValidity();
      return;
    }

    const button = leadForm.querySelector('button[type="submit"]') as HTMLButtonElement;
    button.disabled = true;
    button.textContent = 'Enviando…';
    formStatus!.textContent = '';
    formStatus!.className = 'form-status';

    try {
      const payload = Object.fromEntries(new FormData(leadForm).entries());
      const response = await fetch('/api/lead', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(payload),
      });
      const result = await response.json();
      if (!response.ok) throw new Error(result.message || 'Não foi possível enviar.');

      formStatus!.textContent = 'Recebemos suas informações. Você receberá um retorno pelo contato informado.';
      formStatus!.classList.add('success');
      window.ppaTrack?.('lead_submit', { interesse: payload.interesse, origem: payload.origem });
      leadForm.reset();
    } catch (error) {
      formStatus!.textContent = error instanceof Error
        ? error.message
        : 'Não foi possível enviar agora. Tente novamente em alguns minutos.';
      formStatus!.classList.add('error');
    } finally {
      button.disabled = false;
      button.textContent = 'Enviar informações';
    }
  });
</script>
